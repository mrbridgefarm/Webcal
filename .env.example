# Port som containeren og Express-serveren lytter på
PORT=3000

# Valgfri standard Mailcow / SOGo URL (kan også indtastes direkte i login-billedet i browseren)
# Eksempel: https://mail.ditdomæne.dk/SOGo/dav/
DEFAULT_CALDAV_URL=

# Tillad selv-signerede certifikater på intern Mailcow VM (sæt kun til true ved test på lukket LAN)
ALLOW_INSECURE_TLS=false
